# Plantilla de variables para docker-compose.yml.
# 1. Copia este archivo y renómbralo a ".env" (en la misma carpeta).
# 2. Cambia los valores de ejemplo por los tuyos.
# El archivo .env NO se sube a Git; este .env.example sí (sin datos reales).

# Cuenta de Gmail desde la que n8n envía los correos
CORREO_REMITENTE=tu_cuenta@gmail.com

# Correo que recibe las alertas (puede ser el mismo)
CORREO_DESTINO=destino@ejemplo.com

# Máximo de correos que envía la demostración (uno por minuto).
# 5 = demo corta · 0 = flujo completo (los 108 turnos, ~1 h 50 min)
LIMITE_CORREOS_DEMO=5

# Zona horaria (lista: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones)
ZONA_HORARIA=America/Costa_Rica

# IMPORTANTE: la contraseña de aplicación de Gmail NO va aquí.
# Se escribe solo dentro de n8n (Credenciales -> SMTP).
